                  "when": "open-catalog",
                  "then": {
                    "visibleTrails": [
                      "fern",
                      "ridge",
                      "lake"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "FEAT-102",
          "title": "Step-free trail filter",
          "outcome": "Visitors can quickly find step-free routes.",
          "stories": [
            {
              "id": "STORY-102",
              "title": "Filter for step-free trails",
              "asA": "trail visitor",
              "iWant": "to show only step-free options and clear the filter",
              "soThat": "I can choose a trail that suits my visit",
              "architectureNode": "step_free_filter",
              "acceptanceCriteria": [
                {
                  "id": "AC-102",
                  "given": "All trails are visible",
                  "when": "filter-step-free",
                  "then": {
                    "visibleTrails": [
                      "fern",
